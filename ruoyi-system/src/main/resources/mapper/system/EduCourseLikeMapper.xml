<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduCourseLikeMapper">

    <resultMap id="EduCourseLikeResult" type="com.ruoyi.system.domain.course.EduCourseLike">
        <id property="likeId" column="like_id"/>
        <result property="courseId" column="course_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectEduCourseLike" resultMap="EduCourseLikeResult">
        select like_id, course_id, user_id, create_time
        from edu_course_like
        where course_id = #{courseId}
          and user_id = #{userId}
        limit 1
    </select>

    <insert id="insertEduCourseLike" parameterType="com.ruoyi.system.domain.course.EduCourseLike" useGeneratedKeys="true" keyProperty="likeId">
        insert into edu_course_like (course_id, user_id, create_time)
        values (#{courseId}, #{userId}, sysdate())
    </insert>

    <delete id="deleteEduCourseLike">
        delete from edu_course_like
        where course_id = #{courseId}
          and user_id = #{userId}
    </delete>

    <delete id="deleteEduCourseLikeByCourseIds" parameterType="Long">
        delete from edu_course_like
        where course_id in
        <foreach collection="array" item="courseId" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </delete>

</mapper>
