<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduCourseFavoriteMapper">

    <resultMap id="EduCourseFavoriteResult" type="com.ruoyi.system.domain.course.EduCourseFavorite">
        <id property="favoriteId" column="favorite_id"/>
        <result property="courseId" column="course_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="FavoriteCourseResult" type="com.ruoyi.system.domain.course.EduCourse">
        <id property="courseId" column="course_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="courseName" column="course_name"/>
        <result property="courseSubtitle" column="course_subtitle"/>
        <result property="coverImage" column="cover_image"/>
        <result property="intro" column="intro"/>
        <result property="detailHtml" column="detail_html"/>
        <result property="tags" column="tags"/>
        <result property="difficultyLevel" column="difficulty_level"/>
        <result property="publishStatus" column="publish_status"/>
        <result property="recommendFlag" column="recommend_flag"/>
        <result property="hotFlag" column="hot_flag"/>
        <result property="bannerFlag" column="banner_flag"/>
        <result property="allowRegister" column="allow_register"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="viewCount" column="view_count"/>
        <result property="likeCount" column="like_count"/>
        <result property="enrollCount" column="enroll_count"/>
        <result property="contentCount" column="content_count"/>
        <result property="examCount" column="exam_count"/>
        <result property="lastContentTime" column="last_content_time"/>
        <result property="publishTime" column="publish_time"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="categoryName" column="category_name"/>
        <result property="teacherName" column="teacher_name"/>
        <result property="favorited" column="favorited"/>
    </resultMap>

    <select id="selectEduCourseFavorite" resultMap="EduCourseFavoriteResult">
        select favorite_id, course_id, user_id, create_time
        from edu_course_favorite
        where course_id = #{courseId}
          and user_id = #{userId}
        limit 1
    </select>

    <insert id="insertEduCourseFavorite" parameterType="com.ruoyi.system.domain.course.EduCourseFavorite" useGeneratedKeys="true" keyProperty="favoriteId">
        insert into edu_course_favorite (course_id, user_id, create_time)
        values (#{courseId}, #{userId}, sysdate())
    </insert>

    <delete id="deleteEduCourseFavorite">
        delete from edu_course_favorite
        where course_id = #{courseId}
          and user_id = #{userId}
    </delete>

    <select id="selectUserFavoriteCourseList" parameterType="Long" resultMap="FavoriteCourseResult">
        select c.course_id, c.category_id, c.teacher_id, c.course_name, c.course_subtitle, c.cover_image,
               c.intro, c.detail_html, c.tags, c.difficulty_level, c.publish_status, c.recommend_flag,
               c.hot_flag, c.banner_flag, c.allow_register, c.sort_order, c.view_count, c.like_count,
               c.enroll_count, c.content_count, c.exam_count, c.last_content_time, c.publish_time,
               c.status, c.del_flag, c.create_by, c.create_time, c.update_by, c.update_time, c.remark,
               cat.category_name, u.nick_name as teacher_name, true as favorited
        from edu_course_favorite f
                 inner join edu_course c on f.course_id = c.course_id
                 left join edu_course_category cat on c.category_id = cat.category_id
                 left join sys_user u on c.teacher_id = u.user_id
        where f.user_id = #{userId}
          and c.del_flag = '0'
          and c.status = '0'
          and c.publish_status = '1'
        order by f.create_time desc, f.favorite_id desc
    </select>

    <delete id="deleteEduCourseFavoriteByCourseIds" parameterType="Long">
        delete from edu_course_favorite
        where course_id in
        <foreach collection="array" item="courseId" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </delete>

</mapper>
